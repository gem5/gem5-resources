            "readfile_contents": "dd if=/dev/zero of=/tmp/lmbench_scratch bs=1M count=8 status=none && /home/gem5/lmbench/bin/x86_64-linux-gnu/bw_file_rd 8m io_only /tmp/lmbench_scratch && rm -f /tmp/lmbench_scratch; sleep 5;"
