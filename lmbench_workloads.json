        ],
        "code_examples": [],
        "description": "Measures the latency of a demand page fault on a file-backed anonymous mapping (/tmp/lmbench_scratch). The benchmark mmap()s the file, then touches each page cold to trigger a page fault, reporting the average fault-handling latency in microseconds.",
        "source_url": "",
        "license": "",
        "tags": [
            "x86",
            "fullsystem",
            "os"
        ],
        "example_usage": "obtain_resource(\"x86-ubuntu-24.04-lmbench-lat-pagefault\", resource_version=\"1.0.0\")",
        "gem5_versions": [
            "25.0",
            "25.1"
        ],
        "size": 0,
        "architecture": "X86",
        "function": "set_kernel_disk_workload",
        "additional_params": {
            "kernel_args": [
                "earlyprintk=ttyS0",
                "console=ttyS0",
                "lpj=7999923",
                "root=/dev/sda2"
            ],
            "readfile_contents": "dd if=/dev/zero of=/tmp/lmbench_scratch bs=1M count=8 status=none && /home/gem5/lmbench/bin/x86_64-linux-gnu/lat_pagefault /tmp/lmbench_scratch && rm -f /tmp/lmbench_scratch; sleep 5;"
        },
        "resources": {
